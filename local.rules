alert tcp any any -> $HOME_NET !443 (msg:"CUSTOM SCAN Port scan detected - multiple ports probed"; flags:S; threshold:type both, track by_src, count 15, seconds 5; classtype:attempted-recon; sid:9000001; rev:2;)
alert icmp any any -> $HOME_NET any (msg:"CUSTOM RECON ICMP Ping Sweep detected"; itype:8; threshold:type both, track by_src, count 5, seconds 10; classtype:attempted-recon; sid:9000002; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"CUSTOM DDOS Possible SYN Flood detected"; flags:S; threshold:type both, track by_dst, count 100, seconds 5; classtype:attempted-dos; sid:9000003; rev:1;)

